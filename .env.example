# Banco. Dev usa SQLite; produção (Vercel) usa Postgres do Neon: troque o provider
# em prisma/schema.prisma para "postgresql" e ponha a connection string aqui.
DATABASE_URL="file:./dev.db"

# Segredo do servidor (obrigatório): assina/criptografa. Gere um forte com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="troque-por-um-segredo-forte"

# Opcional: se definido, criar conta exige este código (app por convite).
# CODIGO_CONVITE="minha-turma-2026"

# IA (fase 5) — configuração global. A CHAVE é por usuário (cada um cola a sua em Você);
# não existe chave de IA no servidor.
# IA_MODELO="claude-sonnet-5"     # padrão claude-sonnet-5; pode ser claude-haiku-4-5 ou claude-opus-5
# IA_LIMITE_DIARIO="40"           # teto de chamadas de IA por dia por usuário
