# Banco. Dev usa SQLite; produção troca o provider em prisma/schema.prisma e esta URL.
DATABASE_URL="file:./dev.db"

# IA (fase 5) — opcional. Sem chave, os recursos de IA ficam desligados e o resto do app funciona igual.
# Pegue uma chave em https://console.anthropic.com (conta da API, cobrada por token, separada do plano Pro).
# ANTHROPIC_API_KEY="sk-ant-..."
# IA_MODELO="claude-sonnet-5"     # padrão claude-sonnet-5; pode ser claude-haiku-4-5 ou claude-opus-5
# IA_LIMITE_DIARIO="40"           # máximo de chamadas de IA por dia (controle de custo)
